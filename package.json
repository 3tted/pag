{
  "name": "vyrox-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @vyrox/web dev",
    "build": "bun --filter @vyrox/web build",
    "build:render": "NITRO_PRESET=node-server bun --filter @vyrox/web build",
    "start": "node apps/web/.output/server/index.mjs",
    "lint": "bun --filter '*' lint"
  }
}
